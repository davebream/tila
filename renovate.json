{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    "security:minimumReleaseAgeNpm",
    ":maintainLockFilesWeekly"
  ],
  "timezone": "Europe/Warsaw",
  "schedule": ["* 0-6 * * 1"],
  "updateNotScheduled": true,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "rebaseWhen": "behind-base-branch",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false,
    "schedule": ["* 0-6 * * 1"]
  },
  "packageRules": [
    {
      "description": "Batch compatible npm runtime updates across the workspace.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "runtime dependencies"
    },
    {
      "description": "Keep build and test tooling separate from production dependencies.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "build and test tooling"
    },
    {
      "description": "Validate UI libraries and their testing tools together.",
      "matchManagers": ["npm"],
      "matchFileNames": ["packages/ui/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "ui dependencies"
    },
    {
      "description": "Keep Cloudflare runtime tooling together for the required runtime gate.",
      "matchPackageNames": [
        "@cloudflare/*",
        "wrangler",
        "miniflare",
        "workerd"
      ],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "cloudflare tooling",
      "automerge": false
    },
    {
      "description": "Keep standalone npm experiments out of production update groups.",
      "matchManagers": ["npm"],
      "matchFileNames": ["experiments/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "experiment dependencies",
      "automerge": false
    },
    {
      "description": "Batch compatible action updates while preserving SHA pins.",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "github actions",
      "automerge": true
    },
    {
      "description": "Automatically merge npm patch fixes after required CI passes.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Keep Cloudflare tooling and experiment changes under review.",
      "matchPackageNames": [
        "@cloudflare/*",
        "wrangler",
        "miniflare",
        "workerd"
      ],
      "automerge": false
    },
    {
      "matchFileNames": ["experiments/**"],
      "automerge": false
    },
    {
      "description": "Pre-1.0 releases do not guarantee compatible minor upgrades.",
      "matchManagers": ["npm"],
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": ["minor"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "groupName": null
    },
    {
      "description": "Approve each major migration independently on the dashboard.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "groupName": null
    },
    {
      "description": "Node 22 is the public consumer compatibility floor, not the build runtime.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["node"],
      "matchCurrentVersion": "22",
      "allowedVersions": "22.x"
    },
    {
      "description": "Match Node types to the supported Node 22 public API.",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "22.x"
    }
  ]
}
