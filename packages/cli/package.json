{
  "name": "tila-cli",
  "version": "0.4.0",
  "license": "MIT",
  "description": "tila CLI — durable state & coordination for multi-machine agentic work",
  "keywords": [
    "tila",
    "cli",
    "agentic",
    "ai-agents",
    "agent-coordination",
    "cloudflare",
    "mcp",
    "state-management"
  ],
  "author": "Dawid Leszczyński (https://github.com/davebream)",
  "homepage": "https://github.com/davebream/tila#readme",
  "bugs": "https://github.com/davebream/tila/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davebream/tila.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "tila": "bin/tila.cjs"
  },
  "files": ["bin"],
  "scripts": {
    "build": "pnpm run gen:version && tsc",
    "dev": "pnpm run gen:version && bun --tsconfig-override ../../tsconfig.json src/index.ts",
    "test": "vitest run",
    "typecheck": "pnpm run gen:version && tsc --noEmit",
    "clean": "rm -rf dist",
    "build:worker-sidecar": "pnpm --filter @tila/worker exec wrangler deploy --dry-run --outdir ../cli/worker --metafile ../cli/worker/bundle-meta.json",
    "compile": "node ../../scripts/compile-binaries.mjs",
    "compile:installers": "mkdir -p dist/binaries && cp ../../scripts/install.sh ../../scripts/install.ps1 dist/binaries/",
    "compile:linux-x64": "node ../../scripts/compile-binaries.mjs linux-x64",
    "compile:linux-arm64": "node ../../scripts/compile-binaries.mjs linux-arm64",
    "compile:linux-x64-musl": "node ../../scripts/compile-binaries.mjs linux-x64-musl",
    "compile:linux-arm64-musl": "node ../../scripts/compile-binaries.mjs linux-arm64-musl",
    "compile:darwin-arm64": "node ../../scripts/compile-binaries.mjs darwin-arm64",
    "compile:darwin-x64": "node ../../scripts/compile-binaries.mjs darwin-x64",
    "compile:windows-x64": "node ../../scripts/compile-binaries.mjs windows-x64",
    "compile:windows-arm64": "node ../../scripts/compile-binaries.mjs windows-arm64",
    "gen:version": "node ../../scripts/generate-version.mjs cli"
  },
  "optionalDependencies": {
    "tila-cli-darwin-arm64": "0.4.0",
    "tila-cli-darwin-x64": "0.4.0",
    "tila-cli-linux-arm64": "0.4.0",
    "tila-cli-linux-arm64-musl": "0.4.0",
    "tila-cli-linux-x64": "0.4.0",
    "tila-cli-linux-x64-musl": "0.4.0",
    "tila-cli-windows-arm64": "0.4.0",
    "tila-cli-windows-x64": "0.4.0"
  },
  "devDependencies": {
    "@bomb.sh/tab": "^0.0.22",
    "@clack/prompts": "^1.8.1",
    "@tila/auth-store": "workspace:*",
    "@tila/backend-embedded": "workspace:*",
    "@tila/backend-local": "workspace:*",
    "@tila/client-lifecycle": "workspace:*",
    "@tila/core": "workspace:*",
    "@tila/ops-sqlite": "workspace:*",
    "@tila/schemas": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "ansis": "^4.4.0",
    "better-sqlite3": "^13.0.3",
    "citty": "^0.2.2",
    "cloudflare": "^7.3.0",
    "console-table-printer": "^2.16.1",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "jose": "^6.2.12",
    "object-treeify": "^5.0.1",
    "smol-toml": "^1.8.0",
    "tila-sdk": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9",
    "yaml": "^2.9.1",
    "yocto-spinner": "^1.2.2",
    "zod": "^3.24.0"
  }
}
