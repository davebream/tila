{
  "name": "@tila/worker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./test-support": "./src/test-support/index.ts"
  },
  "scripts": {
    "prebuild": "node ../../scripts/generate-version.mjs worker",
    "dev": "pnpm run gen:version && wrangler dev --local -c wrangler.dev.toml --tsconfig ../../tsconfig.json",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "typecheck": "pnpm run gen:version && tsc --noEmit",
    "clean": "rm -rf dist .wrangler",
    "gen:version": "node ../../scripts/generate-version.mjs worker"
  },
  "dependencies": {
    "@tila/core": "workspace:*",
    "@tila/ops-sqlite": "workspace:*",
    "@tila/schemas": "workspace:*",
    "@tila/ui": "workspace:*",
    "better-auth": "1.7.7",
    "better-call": "1.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "smol-toml": "^1.8.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "better-sqlite3": "^13.0.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.148.0"
  }
}
