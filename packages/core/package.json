{
  "name": "@tila/core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./settings-execution": {
      "types": "./dist/settings-execution.d.ts",
      "import": "./dist/settings-execution.js",
      "default": "./dist/settings-execution.js"
    },
    "./definition-yaml": {
      "types": "./dist/definition-yaml.d.ts",
      "import": "./dist/definition-yaml.js",
      "default": "./dist/definition-yaml.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tila/schemas": "workspace:*",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
