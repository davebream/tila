{
  "name": "@tila/backend-do",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "node ../../scripts/generate-version.mjs backend-do",
    "build": "pnpm run gen:version && tsc",
    "dev": "pnpm run gen:version && tsc --watch",
    "test": "vitest run",
    "typecheck": "pnpm run gen:version && tsc --noEmit",
    "clean": "rm -rf dist",
    "gen:version": "node ../../scripts/generate-version.mjs backend-do"
  },
  "dependencies": {
    "@tila/core": "workspace:*",
    "@tila/ops-sqlite": "workspace:*",
    "@tila/schemas": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
