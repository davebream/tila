{
  "mcpServers": {
    "tila-dev": {
      "command": "pnpm",
      "args": [
        "--silent",
        "dev:cli",
        "--instance",
        "http://localhost:8787",
        "--project",
        "dev-project",
        "run",
        "exec",
        "--",
        "pnpm",
        "--silent",
        "dev:mcp"
      ],
      "env": {
        "TILA_HOME": ".tila/dev-auth"
      }
    }
  }
}
