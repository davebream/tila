{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "gen:version"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "!src/version.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "!src/version.ts"],
      "env": ["CI", "VITEST_MAX_WORKERS"]
    },
    "typecheck": {
      "dependsOn": ["^build", "gen:version"],
      "inputs": ["$TURBO_DEFAULT$", "!src/version.ts"]
    },
    "clean": {
      "cache": false
    },
    "gen:version": {
      "inputs": ["package.json", "$TURBO_ROOT$/scripts/generate-version.mjs"],
      "outputs": ["src/version.ts"]
    },
    "@tila/backend-do#gen:version": {
      "inputs": ["package.json", "$TURBO_ROOT$/scripts/generate-version.mjs"],
      "outputs": ["src/version.ts"],
      "env": ["TILA_BUILD_REVISION"]
    },
    "@tila/integration-tests#test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@tila/ui#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_API_URL"]
    }
  },
  "globalDependencies": [
    "tsconfig*.json",
    "scripts/**",
    "tests/**",
    ".github/workflows/**"
  ],
  "globalEnv": ["TILA_TOOLCHAIN"]
}
